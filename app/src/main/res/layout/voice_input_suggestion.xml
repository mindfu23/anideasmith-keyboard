<!-- UNUSED, kept on purpose along with VoiceInputStrip, which inflates it. See that class for why.

     Sized to its contents, not to the strip. It shares the row with the pinned toolbar keys, which
     stay reachable while dictating, so it takes only the width the microphone and the stop button
     need. Keeping it full width also made every empty pixel of the strip a stop button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:background="@drawable/clipboard_suggestion_background"
    android:gravity="center"
    android:paddingEnd="12dp"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    tools:ignore="RtlSymmetry">
    <ImageView
        android:id="@+id/voice_input_suggestion_icon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingVertical="6dp"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        android:importantForAccessibility="no" />
    <ImageView
        android:id="@+id/voice_input_suggestion_stop"
        android:contentDescription="@string/voice_input_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center" />

</LinearLayout>
