<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:background="@drawable/clipboard_suggestion_background"
    android:gravity="center"
    android:paddingEnd="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="RtlSymmetry">
    <ImageView
        android:id="@+id/voice_input_suggestion_icon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:paddingVertical="6dp"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/voice_input_suggestion_text"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:paddingEnd="6dp"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false"
        android:singleLine="true"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:textStyle="bold"
        style="?android:attr/textAppearanceSmall" />
    <ImageView
        android:id="@+id/voice_input_suggestion_stop"
        android:contentDescription="@string/voice_input_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center" />

</LinearLayout>
